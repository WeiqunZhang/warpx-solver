# Standalone MLMG test for the rlehe_cylinder WarpX case (inputs_D).
# Solver-relevant subset of inputs_D.  rho = 0 and phi = 0 initially, so the
# EB Dirichlet potential drives the solve (the step-0 solve of the WarpX run).
#
#   mpirun -np 1 ./cylinder3d.gnu.TPROF.MPI.ex inputs

# ---- mesh ----------------------------------------------------------------
amr.n_cell        = 1024 1024 256    # nx nx nz
amr.max_grid_size = 128              # one value or one per direction

# device_width = 0.51*2
geometry.prob_lo  = -0.51 -0.51 -2e-3
geometry.prob_hi  =  0.51  0.51 50e-3

# ---- EB ------------------------------------------------------------------
eb2.geom_type           = stl
eb2.stl_file            = cylinder_4x.stl
eb2.cover_multiple_cuts = 1
warpx.eb_potential(x,y,z,t) = " -40e3*(z>16.5e-3) - 41e3*(z>5.50e-3)*(z<16.5e-3)"
problem.time            = 0.0        # t passed to eb_potential

# Domain BCs (hard-wired in main.cpp):
#   boundary.field_lo = neumann neumann pec, boundary.potential_lo_z = 0
#   boundary.field_hi = neumann neumann neumann

# ---- MLMG (WarpX defaults + inputs_D tolerances) -------------------------
mlmg.verbose        = 2       # warpx.self_fields_verbosity
mlmg.bottom_verbose = 1
mlmg.max_iter       = 200     # warpx.self_fields_max_iters
mlmg.reltol         = 1e-6    # warpx.self_fields_required_precision (1e-4 in inputs_D)
mlmg.abstol         = 0.0     # warpx.self_fields_absolute_tolerance
mlmg.bottom_reltol  = 3e-4    # bottom solver, and AlgMG in the algebraic solves
mlmg.final_smooth   = 8       # warpx.self_fields_num_final_sweeps

# ---- driver --------------------------------------------------------------
nsolves   = 3   # each solve rebuilds linop + MLMG, as WarpX does every step;
                # every solve runs twice: geometric MG, then AlgMG
reset_phi = 1   # 1: phi = 0 before every solve so all solves do the same work
