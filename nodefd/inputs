# Defaults are spelled out so this file documents every knob.

# ---- problem size / decomposition -------------------------------------
n_cell          = 128       # domain is n_cell^3, no EB
# 0 = non-periodic (homogeneous Dirichlet), 1 = periodic.
# Dirichlet in x removes the constant nullspace.  A fully periodic domain is
# singular, and because MLEBNodeFDLaplacian hard-codes isSingular()==false the
# constant mode is never projected out -- which made the bottom solve
# pathological on coarse grids and made bicgstab diverge outright at 7 levels.
is_periodic     = 0 1 1
nboxes          = -1        # <=0 -> ParallelDescriptor::NProcs(); 2nd arg to amrex::decompose

# ---- benchmark loop ---------------------------------------------------
nwarmup         = 1         # untimed solves first
nsolves         = 5         # timed solves
recreate_linop  = 0         # 0: build once, reuse -- isolates the V-cycle cost (standing default)
                            # 1: rebuild linop every solve (what WarpX does; costs 3-6%)

# ---- the flag under study ---------------------------------------------
nosync          = 1         # MLMG::setNoGpuSync -- established a win, kept on

# ---- MLMG -------------------------------------------------------------
verbose         = 1         # WarpX uses 2; 1 keeps output readable over many solves
linop_verbose   = 2         # >=2 records 'agglomerated ... starting at MG level N of M'
bottom_verbose  = 0
max_iter        = 200       # WarpX self_fields_max_iters
# >0 -> MLMG::setFixedIter.  This caps the iteration count and disables the
# "MLMG failed." abort, but MLMG still breaks out early once it converges
# (AMReX_MLMG.H:883,921).  For exactly N V-cycles of identical work every
# solve, pair it with reltol=0.0:   fixed_iter=12 reltol=0.0
fixed_iter      = 0
reltol          = 1.e-11    # WarpX self_fields_required_precision
abstol          = 0.0       # WarpX self_fields_absolute_tolerance
# With Dirichlet in x the operator is non-singular, so the stock bicgstab
# bottom solver is stable at every coarsening depth (verified mcl=30..2, 1 and
# 4 ranks).  The 'smoother' workaround needed for the all-periodic problem in
# run-000 is no longer required.
bottom_solver   = bicgstab  # default(bicgstab) / bicgstab / cg / bicgcg / cgbicg / smoother
pre_smooth      = 2
post_smooth     = 2
final_smooth    = 8
bottom_smooth   = 0

# ---- LPInfo (AMReX defaults; WarpX sets none of these) ----------------
max_coarsening_level = 30
agglomeration        = 1
consolidation        = 1
agg_grid_size        = -1   # -1 -> 32 on GPU. Controls WHERE agglomeration starts:
                            #   8 -> lvl 4, 16 -> lvl 3, 32 -> lvl 2, 64+ -> lvl 1 (of 6)
con_grid_size        = -1
# con_* are INACTIVE while agglomeration=1 (a covered domain takes the
# agglomeration branch).  They only bite with agglomeration=0.
con_ratio            = 2    # rank-count reduction per consolidation step
con_strategy         = 3    # 1: by rank index, 2: modulo, 3: SFC reorder then index
semicoarsening       = 0

# ---- operator ---------------------------------------------------------
sigma           = 1.0       # WarpX lab frame: 1 - beta^2 = 1

# ---- profiling --------------------------------------------------------
# Keep this OFF when measuring nosync.  It makes TinyProfiler call
# Gpu::streamSynchronize() at every start/stop (AMReX_TinyProfiler.cpp:151,205),
# and explicit syncs still fire inside a NoSync region -- so it puts back
# exactly the syncs nosync=1 removes and makes the flag look worthless.
# The driver does its own sync around each timed solve, so the reported
# per-solve wall times are correct either way.
# Turn it ON (=1) only to attribute cost per kernel within one fixed config.
tiny_profiler.device_synchronize_around_region = 0
